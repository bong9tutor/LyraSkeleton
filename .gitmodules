[submodule "Plugins/Monolith"]
	path = Plugins/Monolith
	url = https://github.com/tumourlove/monolith.git
	# monolith v0.14.7+ 자체가 `wiki` 를 nested submodule(gitlink) 로 등록한 채
	# `.gitmodules` 매핑을 함께 푸시하지 않은 upstream quirk 가 있어,
	# `git clone --recurse-submodules` / `git submodule update --init --recursive`
	# 가 자식 안으로 들어가는 순간 "No url found for ... 'Plugins/Monolith/wiki'"
	# 로 실패한다. `update = none` 으로 init 후 checkout 단계를 skip 시켜 git 이
	# 자식 working tree 안으로 들어가지 않게 막는다.
	# 본 저장소에서 monolith 본체를 실제로 받으려면 README 의 "1. 저장소 클론"
	# 절 안내에 따라 명시적 update 명령 한 줄을 실행해야 한다.
	update = none
